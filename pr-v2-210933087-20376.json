entelemetry-java-instrumentation","request_digest":"242c5aafdaa8cbfa2ecbb972f72dad30646e4b40044ab19817e8b7b1fa8aaece","request_id":"1af2f86a08a14df99ca821e46b04186d","run_attempt":1,"run_id":37974064704,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:d338ac5d92dc47a1ea1b9f0005c038a8eff61b2c3d9b08efb2614942ef6b5032","verification":"verified","verification_run":{"attempt":1,"id":37975259424},"workflow_revision":"9ecf52fc8587608c838ce6d40de011f37516e60b"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5402526598,5428614365,5458879863,5458889852,5458900984,5458903345,5459208459,5472029729,5472530654,5472582413,5473668551],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nThe library README incorrectly claims JFR-sourced GC duration points include `jvm.gc.cause`.\n\n<details open>\n<summary><strong>1 open finding</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-light.png\" alt=\"Low severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Clarify JFR and JMX behavior for jvm.gc.duration](https://github.com/open-telemetry/opentelemetry-java-instrumentation/pull/20376#discussion_r4233122049) \u00b7 New\n</details>\n\n\ud83e\udde0 **Review effort:** Balanced","comment_id":null,"key":"review:5473668551","kind":"body","line":null,"path":null,"review_id":5473668551},{"body":"[General] This is only true for JMX-sourced GC metrics. When `jvm.gc.duration` is selected for JFR, the JFR handlers record only `jvm.gc.name` and `jvm.gc.action` (for example, `G1GarbageCollectionHandler.java:30-31,53`), so this sentence misdocuments a supported selector path. Scope the claim to JMX and clarify the JFR behavior.","comment_commit_id":"68d09a93c8e89131117e55f2b79b87393824ee1c","comment_id":4233122049,"key":"inline:4233122049","kind":"inline","line":218,"original_commit_id":"68d09a93c8e89131117e55f2b79b87393824ee1c","original_line":218,"path":"instrumentation/runtime-telemetry/library/README.md","review_commit_id":"68d09a93c8e89131117e55f2b79b87393824ee1c","review_id":5473668551,"review_submitted_at":"2026-10-09T18:03:52Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"49dc8bea09ae3c3f2dde539d6d4cbef67ca4076d70cfe01274d07f5514d494b1","id":4233122049,"parent":null,"updated_at":"2026-10-09T18:03:52Z"}],"thread_id":"PRRT_kwDODJKVX86q5JEp"}],"frozen_at":1791570748,"frozen_at_iso":"2026-10-09T18:32:28Z","frozen_sha":"68d09a93c8e89131117e55f2b79b87393824ee1c","head_ref":"trask-runtime-telemetry-stabilization","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":37973976023},"loop_kind":"copilot_review","mode":"publish","pr":20376,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791570750,"generation":9,"max_pipelines":5,"phase":"1edbe7159f234478a1bf8c67ba71dd2a","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"1af2f86a08a14df99ca821e46b04186d","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/9ecf52fc8587608c838ce6d40de011f37516e60b","workflow_revision":"9ecf52fc8587608c838c