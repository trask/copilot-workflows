tation/couchbase/couchbase-2.0/javaagent/src/test/java/io/opentelemetry/javaagent/instrumentation/couchbase/v2_0/CouchbaseQuerySanitizationTest.java","instrumentation/couchbase/couchbase-2.0/javaagent/src/test/resources/common-query-sanitization-disabled.yaml","instrumentation/couchbase/couchbase-2.0/javaagent/src/test/resources/query-sanitization-disabled.yaml"],"commit":"df0172ff82be3eff2d9a960129377e8da3a4fefa","commits":[{"changed_paths":[".github/scripts/instrumentations.sh","instrumentation/couchbase/couchbase-2.0/javaagent/build.gradle.kts","instrumentation/couchbase/couchbase-2.0/javaagent/src/test/java/io/opentelemetry/javaagent/instrumentation/couchbase/v2_0/CouchbaseQuerySanitizationTest.java","instrumentation/couchbase/couchbase-2.0/javaagent/src/test/resources/common-query-sanitization-disabled.yaml","instrumentation/couchbase/couchbase-2.0/javaagent/src/test/resources/query-sanitization-disabled.yaml"],"commit":"df0172ff82be3eff2d9a960129377e8da3a4fefa","parent":"ec0b2c2e99d499d8ce9f807ff68fa944dcef6e2c","patch_sha256":"4ef90330a5f88b1e707ce2f022bac66b2ec9026fe453811e687c21d57877fa90","subject":"Test Couchbase query sanitization through the installed agent","tree":"6ea09a80dfd7e249b195dcc8c447a538ed21e426"}],"cumulative_patch_sha256":"4ef90330a5f88b1e707ce2f022bac66b2ec9026fe453811e687c21d57877fa90","finding_commits":{"inline:4233336415":"df0172ff82be3eff2d9a960129377e8da3a4fefa","review:5473911478":"df0172ff82be3eff2d9a960129377e8da3a4fefa"},"parent":"ec0b2c2e99d499d8ce9f807ff68fa944dcef6e2c","patch_sha256":"4ef90330a5f88b1e707ce2f022bac66b2ec9026fe453811e687c21d57877fa90","tree":"6ea09a80dfd7e249b195dcc8c447a538ed21e426"},"dispositions":{"findings":[{"analysis":"This overview summarizes the same single coverage gap as inline:4233336415. Commit 1 adds and verifies the requested installed-agent coverage through real initialization and bucket advice.","commit":1,"disposition":"fixed","key":"review:5473911478"},{"analysis":"Added installed-agent coverage invoking the real CouchbaseAsyncBucket.query path with an N1qlQuery and a stub transport. Separate JVMs cover default sanitization, Couchbase flat and declarative disablement, and inherited common flat and declarative disablement. The Couchbase declarative fixture overrides an enabled common setting. Exact exported attributes assert raw or masked db.query.text as configured and unchanged derived db.query.summary and span name. All five cases and the experimental variant passed.","commit":1,"disposition":"fixed","key":"inline:4233336415"}],"input_identity":{},"outcome":"fixes","request_digest":"a534090c274753f1a8a7e556ec1f92fa48f97e8f652f7b6ec6011efe2e6e8bab","schema":2},"download_sha256":"ed89bdab9acb9f4750758be8a486761df1f5c06b2952c77990e0f3ef5a598fcc","frozen_sha":"ec0b2c2e99d499d8ce9f807ff68fa944dcef6e2c","pr":20478,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"a534090c274753f1a8a7e556ec1f92fa48f97e8f652f7b6ec6011efe2e6e8bab","request_id":"3264b1ea4f504768a73d49bc7f917db7","run_attempt":1,"run_id":37974007884,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:ed89bdab9acb9f4750758be8a486761df1f5c06b2952c77990e0f3ef5a598fcc","verification":"verified","verification_run":{"attempt":1,"id":37977050350},"workflow_revision":"9ecf52fc8587608c838ce6d40de011f37516e60b"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5473843561,5473857081,5473911478],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nThe new sanitization configuration wiring lacks agent-backed coverage through the real initialization path.\n\n<details open>\n<summary><strong>1 open finding</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Add agent-backed coverage for DbConfig sanitization settings](https://github.com/open-telemetry/opentelemetry-java-instrumentation/pull/20478#discussion_r4233336415) \u00b7 New\n</details>\n\n<details>\n<summary><strong>What changed in this PR</strong></summary>\n\nAdopts shared SQL analysis for Couchbase 2.x SQL++ queries while preserving generic handling for key-value and view operations.\n\n**Changes:**\n- Routes SQL queries through a dedicated SQL getter and instrumenter.\n- Updates telemetry assertions and query extraction tests.\n- Expands Geode sanitization coverage and documents the breaking telemetry change.\n\n| File | Description |\r\n| ---- | ----------- |\r\n| `CHANGELOG.md` | Documents Couchbase telemetry changes. |\r\n| `instrumentation/\u200bgeode-1.4/\u200bjavaagent/\u200bsrc/\u200btest/\u200bjava/\u200bio/\u200bopentelemetry/\u200bjavaagent/\u200binstrumentation/\u200bgeode/\u200bv1_4/\u200bPutGetTest.java` | Expands OQL sanitization cases. |\r\n| `instrumentation/\u200bcouchbase/\u200bcouchbase-common/\u200btesting/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200binstrumentation/\u200bcouchbase/\u200bAbstractCouchbaseClientTest.java` | Updates synchronous query expectations. |\r\n| `instrumentation/\u200bcouchbase/\u200bcouchbase-common/\u200btesting/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200binstrumentation/\u200bcouchbase/\u200bAbstractCouchbaseAsyncClientTest.java` | Updates asynchronous query expectations. |\r\n| `instrumentation/\u200bcouchbase/\u200bcouchbase-common-2.0/\u200bjavaagent/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200bjavaagent/\u200binstrumentation/\u200bcouchbase/\u200bcommon/\u200bv2_0/\u200bCouchbaseRequestInfo.java` | Stores raw query text and SQL classification. |\r\n| `instrumentation/\u200bcouchbase/\u200bcouchbase-common-2.0/\u200bjavaagent/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200bjavaagent/\u200binstrumentation/\u200bcouchbase/\u200bcommon/\u200bv2_0/\u200bCouchbaseQueryText.java` | Extracts SQL and opaque query text. |\r\n| `instrumentation/\u200bcouchbase/\u200bcouchbase-common-2.0/\u200bjavaagent-unit-tests/\u200bsrc/\u200btest/\u200bjava/\u200bio/\u200bopentelemetry/\u200bjavaagent/\u200binstrumentation/\u200bcouchbase/\u200bv2_0/\u200bCouchbaseAttributesGetterTest.java` | Tests SQL and generic extraction behavior. |\r\n| `instrumentation/\u200bcouchbase/\u200bcouchbase-common-2.0/\u200bjavaagent-unit-tests/\u200bsrc/\u200btest/\u200bjava/\u200bio/\u200bopentelemetry/\u200bjavaagent/\u200binstrumentation/\u200bcouchbase/\u200bcommon/\u200bv2_0/\u200bCouchbaseQueryTextTest.java` | Tests raw query extraction and copying. |\r\n| `instrumentation/\u200bcouchbase/\u200bcouchbase-2.0/\u200bjavaagent/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200bjavaagent/\u200binstrumentation/\u200bcouchbase/\u200bv2_0/\u200bCouchbaseSqlAttributesGetter.java` | Adds the SQL getter implementation. |\r\n| `instrumentation/\u200bcouchbase/\u200bcouchbase-2.0/\u200bjavaagent/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200bjavaagent/\u200binstrumentation/\u200bcouchbase/\u200bv2_0/\u200bCouchbaseSingletons.java` | Builds separate generic and SQL instrumenters. |\r\n| `instrumentation/\u200bcouchbase/\u200bcouchbase-2.0/\u200bjavaagent/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200bjavaagent/\u200binstrumentation/\u200bcouchbase/\u200bv2_0/\u200bCouchbaseBucketInstrumentation.java` | Selects the instrumenter by query type. |\r\n| `instrumentation/\u200bcouchbase/\u200bcouchbase-2.0/\u200bjavaagent/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200bjavaagent/\u200binstrumentation/\u200bcouchbase/\u200bv2_0/\u200bCouchbaseAttributesGetter.java` | Restricts generic query text to non-SQL operations. |\n</details>\n\n\ud83e\udde0 **Review effort:** Balanced\n\n---\n\n\ud83d\udca1 <a href=\"/open-telemetry/opentelemetry-java-instrumentation/new/main?filename=.github/skills/code-review/SKILL.md\" class=\"Link--inTextBlock\" target=\"_blank\" rel=\"noopener noreferrer\">Add a `code-review` agent skill</a> or configure MCP servers for context-aware, tailored reviews. <a href=\"https://docs.github.com/copilot/how-tos/use-copilot-agents/request-a-code-review/use-code-review?tool=webui#mcp-servers-and-agent-skills\" class=\"Link--inTextBlock\" target=\"_blank\" rel=\"noopener noreferrer\">Learn more in the docs.</a>","comment_id":null,"key":"review:5473911478","kind":"body","line":null,"path":null,"review_id":5473911478},{"body":"[Testing] The new sanitization coverage constructs `SqlClientAttributesExtractor` directly, so it never exercises this `DbConfig` lookup or the singleton/instrumenter selection used by an installed agent. A regression in the Couchbase flat, declarative, or inherited common setting could therefore leave `db.query.text` masked while these tests still pass. Please add agent-backed coverage that disables sanitization through the real configuration path and asserts raw `db.query.text` while the query summary and span name remain derived.","comment_commit_id":"ec0b2c2e99d499d8ce9f807ff68fa944dcef6e2c","comment_id":4233336415,"key":"inline:4233336415","kind":"inline","line":56,"original_commit_id":"ec0b2c2e99d499d8ce9f807ff68fa944dcef6e2c","original_line":56,"path":"instrumentation/couchbase/couchbase-2.0/javaagent/src/main/java/io/opentelemetry/javaagent/instrumentation/couchbase/v2_0/CouchbaseSingletons.java","review_commit_id":"ec0b2c2e99d499d8ce9f807ff68fa944dcef6e2c","review_id":5473911478,"review_submitted_at":"2026-10-09T18:29:38Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"456793131a991f97dc40e2a6d5c21ce204fe38ce4140d92a87bc367278b791b0","id":4233336415,"parent":null,"updated_at":"2026-10-09T18:29:38Z"}],"thread_id":"PRRT_kwDODJKVX86q5quH"}],"frozen_at":1791570738,"frozen_at_iso":"2026-10-09T18:32:18Z","frozen_sha":"ec0b2c2e99d499d8ce9f807ff68fa944dcef6e2c","head_ref":"copilot/extend-sqlclientattributesgetter","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":37973955691},"loop_kind":"copilot_review","mode":"publish","pr":20478,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791570740,"generation":2,"max_pipelines":5,"phase":"d962d430368640859dd9dee9200ffa98","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"3264b1ea4f504768a73d49bc7f917db7","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/9ecf52fc8587608c838ce6d40de011f37516e60b","workflow_revision":"9ecf52fc8587608c838ce6d40de011f37516e60b"},"run":{"attempt":1,"conclusion":"success","id":37974007884,"url":"https://github.com/trask/copilot-workflows/actions/runs/37974007884"},"schema":2,"seen_findings":["e233c2d9954ea0b48d648cf9d159758006107c3d30b5419a669929c3a86f42d9"],"seen_inline_findings":["8e51f792f2142e8138093474d08aa18031051cf1c820bb9f6b5699f2518d7662"],"seen_missed_findings":[],"stage":"thread_effects","verification_run":{"attempt":1,"id":37977050350}}