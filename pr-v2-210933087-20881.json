n_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[],"frozen_at":1793018022,"frozen_at_iso":"2026-10-26T12:33:42Z","frozen_sha":"11da012e81fc8075da948af13527530e7fc51648","head_ref":"copilot/http-getter-implementation","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":40323447220},"loop_kind":"pr_conflict_resolver","merge_base_sha":"7e2db50673c71761c609275552958a3d5c79ca78","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nHTTP getters now supply the final `error.type`. Returning `null` intentionally omits it, even with an exception or error HTTP status. Overrides can call the shared role-specific classifier to retain default behavior:\n\n```java\nreturn shouldOmitErrorType(request, response, error)\n    ? null\n    : HttpErrorType.forClient(this, request, response, error);\n```\n\nClient and server interfaces retain defaults backed by `HttpErrorType.forClient()` and `forServer()`. These preserve role-specific status precedence, exception-class fallback, `_OTHER` for missing or non-positive status, and omission on successful responses. Reactor Netty and WebFlux retain their cancellation classification.\n\nThis is a breaking 3.0 behavior change. Span-status behavior is unchanged.","title":"Make HTTP getters own final error.type classification"},"mode":"publish","pr":20881,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1793018023,"generation":3,"max_pipelines":5,"phase":"c06f3250d88846309a604cf6b393d0c1","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"a395bcd19cb14b428936dbd89394949d","schema":2,"source_pri