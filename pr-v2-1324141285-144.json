scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-light.png\" alt=\"High severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Point APP_DIR and App.dir to the sibling application source](#discussion_r4139035949) \u00b7 New\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Use a 32-byte APP_KEY for AES-256-CBC](#discussion_r4139036007) \u00b7 New\n</details>","comment_id":null,"key":"review:5359367713","kind":"body","line":null,"path":null,"review_id":5359367713},{"body":"`ROOT` is the `opentelemetry-cakephp` package, but the application source is its sibling `../scenarios/src` (also used by Composer's autoload mapping). This makes `APP` point to a directory that does not exist. The controller may still autoload, but Cake lookups based on `APP` cannot find application files. Point `APP_DIR` at the sibling source and update `App.dir` in `config/app.php` to match.","comment_commit_id":"ec1e463575801c9229b772fc41550bfa7fdc0647","comment_id":4139035949,"key":"inline:4139035949","kind":"inline","line":10,"original_commit_id":"ec1e463575801c9229b772fc41550bfa7fdc0647","original_line":10,"path":"scenarios/http/php/cakephp/opentelemetry-cakephp/config/paths.php","review_commit_id":"ec1e463575801c9229b772fc41550bfa7fdc0647","review_id":5359367713,"review_submitted_at":"2026-09-29T22:37:39Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"589c57cced24f0a3032e363f3a5cf533c76cb10b7c8828dde2b90d742f6577db","id":4139035949,"parent":null,"updated_at":"2026-09-29T22:37:39Z"}],"thread_id":"PRRT_kwDOTuzK5c6nUaVe"},{"body":"This `APP_KEY` decodes to 30 bytes, but Laravel's default AES-256-CBC encrypter requires 32. If the fixture resolves the encrypter (for example, to handle encrypted cookies), that request fails with an invalid key length. Use a 32-byte key for this test fixture.","comment_commit_id":"ec1e463575801c9229b772fc41550bfa7fdc0647","comment_id":4139036007,"key":"inline:4139036007","kind":"inline","line":3,"original_commit_id":"ec1e463575801c9229b772fc41550bfa7fdc0647","original_line":3,"path":"scenarios/http/php/laravel/opentelemetry-laravel/.env","review_commit_id":"ec1e463575801c9229b772fc41550bfa7fdc0647","review_id":5359367713,"review_submitted_at":"2026-09-29T22:37:39Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"379c7a340760dffbef357f9bbc218964488d280271c5045f2e4718f4391efa4f","id":4139036007,"parent":null,"updated_at":"2026-09-29T22:37:39Z"}],"thread_id":"PRRT_kwDOTuzK5c6nUaWJ"}],"frozen_at":1791483139,"frozen_at_iso":"2026-10-08T18:12:19Z","frozen_sha":"ec1e463575801c9229b772fc41550bfa7fdc0647","head_ref":"trask-php-remaining-scenarios","head_repo":"open-telemetry/semantic-conventions-conformance","head_repo_id":1324141285,"launch_run":{"actor_id":218610,"attempt":1,"id":37822434999},"loop_kind":"copilot_review","mode":"publish","pr":144,"protocol":"reviewable-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791483142,"continuation_deadline":1791490342,"generation":1,"max_pipelines":5