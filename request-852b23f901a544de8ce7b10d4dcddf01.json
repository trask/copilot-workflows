"instrumentation/spring/spring-boot-autoconfigure/build.gradle.kts","instrumentation/spring/spring-boot-autoconfigure/src/testLogbackAppender/java/io/opentelemetry/instrumentation/spring/autoconfigure/internal/instrumentation/logging/LogbackAppenderTest.java"],"commit":"cfb6796ca0b2f0d2dd54ce7ba949430d5c04834d","parent":"3c1a6983a81990aeefa7bfad583b637155ae8667","patch_sha256":"d92c362b9c45d6711cd36fee9fdf38e44e1496e979646f4eb419e29b2a514a0c","subject":"Address Copilot review comment: Verify Spring Logback structured filtering through exported logs","tree":"6198f2bf8325564bfc725001e389465413587eb7"}],"cumulative_patch_sha256":"d92c362b9c45d6711cd36fee9fdf38e44e1496e979646f4eb419e29b2a514a0c","finding_commits":{"inline:4220991978":"cfb6796ca0b2f0d2dd54ce7ba949430d5c04834d"},"parent":"3c1a6983a81990aeefa7bfad583b637155ae8667","patch_sha256":"d92c362b9c45d6711cd36fee9fdf38e44e1496e979646f4eb419e29b2a514a0c","tree":"6198f2bf8325564bfc725001e389465413587eb7"},"dispositions":{"batches":[{"analysis":"The frozen test calls only initializeStructuredAttributesFromProperties on a capturing setter, so it cannot detect listener initialization/restart or mapper filtering regressions. The added SpringApplication integration test emits real Logstash structured arguments and asserts exactly key1=val1, excluding key2 and the nonincluded other key. Four cases cover flat and indexed declarative properties with both XML-declared/restarted and automatically installed appenders. All 36 LogbackAppenderTest cases and module formatting checks passed.","downsides":"Adds a test-only Logstash encoder dependency and four Spring application startups; production dependencies and behavior are unchanged.","findings":["inline:4220991978"],"length":4814,"offset":0,"sha256":"d92c362b9c45d6711cd36fee9fdf38e44e1496e979646f4eb419e29b2a514a0c","summary":"Verify Spring Logback structured filtering through exported logs","upsides":"Detects broken Spring listener wiring, appender restart, selector application, duplicate export, and inclusion/exclusion filtering through actual exported logs."}],"findings":[{"analysis":"The frozen test calls only initializeStructuredAttributesFromProperties on a capturing setter, so it cannot detect listener initialization/restart or mapper filtering regressions. The added SpringApplication integration test emits real Logstash structured arguments and asserts exactly key1=val1, excluding key2 and the nonincluded other key. Four cases cover flat and indexed declarative properties with both XML-declared/restarted and automatically installed appenders. All 36 LogbackAppenderTest cases and module formatting checks passed.","disposition":"fixed","downsides":"Adds a test-only Logstash encoder dependency and four Spring application startups; production dependencies and behavior are unchanged.","key":"inline:4220991978","upsides":"Detects broken Spring listener wiring, appender restart, selector application, duplicate export, and inclusion/exclusion filtering through actual exported logs."}],"input_identity":{},"outcome":"fixes","request_digest":"9497d5eb6af0e7c287d218b44fa852a980f0829efb65b40f750ae103f595af66","schema":2},"download_sha256":"e79f994ebf7ba435057675e2f96e10a250b0a02e8fd96a5f6a76f491900be6ef","frozen_sha":"3c1a6983a81990aeefa7bfad583b637155ae8667","pr":20418,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"9497d5eb6af0e7c287d218b44fa852a980f0829efb65b40f750ae103f595af66","request_id":"852b23f901a544de8ce7b10d4dcddf01","run_attempt":1,"run_id":37888068813,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:e79f994ebf7ba435057675e2f96e10a250b0a02e8fd96a5f6a76f491900be6ef","verification":"verified","verification_run":{"attempt":1,"id":37889828857},"workflow_revision":"9dd7e361f1696014cd75259f5019d3340edaed26"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5437480598,5437827324,5437827889,54