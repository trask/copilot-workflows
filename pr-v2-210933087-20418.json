n/spring/spring-boot-autoconfigure/src/testLogbackAppender/java/io/opentelemetry/instrumentation/spring/autoconfigure/internal/instrumentation/logging/LogbackAppenderTest.java"],"commit":"6d7fd897827f297be74670a38e074e48c054d04b","parent":"cd6a4376389ce9a99cac6583a227995cdf7b7da0","patch_sha256":"f3cf7935952380f3bf5704749019fd58f50b6e0102be948bc2fafbc5c939ecd4","subject":"Address Copilot review comments: Preserve empty Spring selectors and filter empty structured keys","tree":"d31dbc957dd589dddc794354c918512ab9c41a74"}],"cumulative_patch_sha256":"a6d0107d182d912c33b1837855f073ca7c9a9202472e94a009640047c3b2d01c","finding_commits":{"inline:4214926202":"6d7fd897827f297be74670a38e074e48c054d04b","inline:4214926310":"6d7fd897827f297be74670a38e074e48c054d04b"},"parent":"cd6a4376389ce9a99cac6583a227995cdf7b7da0","patch_sha256":"f3cf7935952380f3bf5704749019fd58f50b6e0102be948bc2fafbc5c939ecd4","tree":"d31dbc957dd589dddc794354c918512ab9c41a74"},"dispositions":{"batches":[{"analysis":"Spring no longer forces included=* for empty selectors, so the appender falls back to logback.xml selectors and only defaults to capture-all when both are empty. The mapper's structured selector now rejects null/empty keys before any structured source reaches captureAttribute.","downsides":"Spring tests now assert an empty selector is passed through.","findings":["inline:4214926202","inline:4214926310"],"length":5241,"offset":0,"sha256":"f3cf7935952380f3bf5704749019fd58f50b6e0102be948bc2fafbc5c939ecd4","summary":"Preserve empty Spring selectors and filter empty structured keys","upsides":"Honors XML configuration; empty keys no longer drop log records."}],"findings":[{"analysis":"Summary body only lists the two inline findings, handled separately.","disposition":"not_warranted","downsides":"None.","key":"review:5451663393","upsides":"No duplicate change."},{"analysis":"Default capture-all let empty keys reach captureAttribute; the builder now wraps the selector to reject empty/null keys for KVPs, markers and structured args.","disposition":"fixed","downsides":"Empty-named keys are silently omitted.","key":"inline:4214926202","upsides":"Prevents dropped log records."},{"analysis":"Explicit included=* overrode logback.xml selectors; empty selector is now preserved so the appender resolves XML config then defaults to all.","disposition":"fixed","downsides":"Relies on appender default.","key":"inline:4214926310","upsides":"XML filters honored."}],"outcome":"fixes","request_digest":"207aa48cb1d061c58aad93eb11cd2015e5472e10e7f32179a62a37b0f0195a79","schema":2},"download_sha256":"5e91a0fba93665af1b6284801c4cc1d9759fef1d3e6a463fb3ac254ea2c43d9b","frozen_sha":"cd6a4376389ce9a99cac6583a227995cdf7b7da0","pr":20418,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"207aa48cb1d061c58aad93eb11cd2015e5472e10e7f32179a62a37b0f0195a79","request_id":"da4fee65cca84dc3a534608f734603b6","run_attempt":1,"run_id":37740210631,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:5e91a0fba93665af1b6284801c4cc1d9759fef1d3e6a463fb3ac254ea2c43d9b","verification":"verified","verification_run":{"attempt":1,"id":37742293445},"workflow_revision":"5487a07d3fdd9c4bab3669d3d7763edb8338997e"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5437480598,5437827324,5437827889,5437849721,5447128387,5448100472,5448112907,5448217030,5451619668,5451663393],"budgets":{"deadline_seconds":7200,"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"deadline":1791449634,"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nEmpty Spring selectors override Logback XML configuration, and empty structured keys can drop log records.\n\n<details open>\n<summary><strong>2 open findings</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Filter empty structured attribute keys before OpenTelemetry capture](#discussion_r4214926202) \u00b7 New\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Preserve empty selector to honor Logback XML attribute filters](#discussion_r4214926310) \u00b7 New\n</details>\n\n<details>\n<summary><strong>1 resolved since last review</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-light.png\" alt=\"High severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Skip empty map keys before creating OpenTelemetry attributes](#discussion_r4211861168)\n</details>\n\n\ud83e\udde0 **Review effort:** Balanced\n\n---\n\nGive feedback about Copilot approvals in [this survey](https://survey.alchemer.com/s3/9011660/CCR-Public-Preview-Autoapprove-feedback-survey) to enter a drawing for a $150 gift card.","comment_id":null,"key":"review:5451663393","kind":"body","line":null,"path":null,"review_id":5451663393},{"body":"[General] Structured capture now defaults to all, so empty keys supplied through SLF4J key-value pairs or Logstash markers reach `captureAttribute`. OpenTelemetry rejects empty attribute names, causing that log record to be dropped instead of merely omitting the invalid structured entry. Filter empty keys in the shared structured selector before any structured source is processed.","comment_commit_id":"cd6a4376389ce9a99cac6583a227995cdf7b7da0","comment_id":4214926202,"key":"inline:4214926202","kind":"inline","line":82,"original_commit_id":"cd6a4376389ce9a99cac6583a227995cdf7b7da0","original_line":82,"path":"instrumentation/logback/logback-appender-1.0/library/src/main/java/io/opentelemetry/instrumentation/logback/appender/v1_0/internal/LoggingEventMapper.java","review_commit_id":"cd6a4376389ce9a99cac6583a227995cdf7b7da0","review_id":5451663393,"review_submitted_at":"2026-10-08T05:00:29Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"205ddc83433e42464d54e51f411a8007e18ee585d67ec61faa5d9668939e4aec","id":4214926202,"parent":null,"updated_at":"2026-10-08T05:00:29Z"}],"thread_id":"PRRT_kwDODJKVX86qNFvr"},{"body":"[Config] Converting an absent or empty common selector into an explicit `included=[\"*\"]` selector makes it override `structuredAttributesIncluded` / `structuredAttributesExcluded` declared in `logback.xml`. For example, a Spring application with `<structuredAttributesExcluded>*</structuredAttributesExcluded>` and no corresponding Spring property will unexpectedly capture everything. Preserve an empty selector here so the appender can fall back to its XML selector and only use the capture-all default when both sources are empty.","comment_commit_id":"cd6a4376389ce9a99cac6583a227995cdf7b7da0","comment_id":4214926310,"key":"inline:4214926310","kind":"inline","line":32,"original_commit_id":"cd6a4376389ce9a99cac6583a227995cdf7b7da0","original_line":32,"path":"instrumentation/spring/spring-boot-autoconfigure/src/main/java/io/opentelemetry/instrumentation/spring/autoconfigure/internal/instrumentation/logging/StructuredAttributesConfig.java","review_commit_id":"cd6a4376389ce9a99cac6583a227995cdf7b7da0","review_id":5451663393,"review_submitted_at":"2026-10-08T05:00:29Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"d468136752f1c0e4d89fad407ceceb9dc4980d0ba3805e9a60509a056a87be1b","id":4214926310,"parent":null,"updated_at":"2026-10-08T05:00:29Z"}],"thread_id":"PRRT_kwDODJKVX86qNFwi"}],"frozen_at":1791442434,"frozen_at_iso":"2026-10-08T06:53:54Z","frozen_sha":"cd6a4376389ce9a99cac6583a227995cdf7b7da0","head_ref":"copilot/adopt-structured-logging-defaults","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"launch_run":{"actor_id":218610,"attempt":1,"id":37740164632},"loop_kind":"copilot_review","mode":"publish","pr":20418,"pr_author_id":198982749,"protocol":"reviewable-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791442436,"continuation_deadline":1791449636,"generation":6,"max_pipelines":5,"phase":"e9ded454c6b64c208a13c6a22dfd6509","profile":"reviewable-v1","required_checks":["Analyze (actions)","Analyze Java (none)","Analyze Kotlin (manual)","CodeQL","EasyCLA","build / build-servlet-images","build / common / build","build / common / check-gh-aw-lockfiles","build / common / examples","build / common / fossa-configuration-check","build / common / gradle-plugins","build / common / license-check","build / common / repo-checks","build / common / smoke-test (ubuntu-latest, jetty)","build / common / smoke-test (ubuntu-lates