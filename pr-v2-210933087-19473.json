se,"changed_paths":[],"commit":"76609e9354ebcbe51306d770a84555db8ef722e2","commits":[],"cumulative_patch_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","finding_commits":{},"parent":"76609e9354ebcbe51306d770a84555db8ef722e2","patch_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","tree":"d6827681665c1a67764671aa597903db411fc755"},"dispositions":{"comments":[{"body":"[P2] [Javaagent] Run the provider subscription in the GenAI context\n\n`contextWrite` makes the GenAI context available in Reactor context, but it does not make it current while the source is subscribed. This `runWithContext(..., parentContext)` instead forces that subscription to run in the parent context. A supported stream implementation such as `Flux.defer(() -> Flux.just(delegate.call(prompt)))` consequently enters the delegate with no `GEN_AI_CLIENT` marker. With the installed Java agent, this produces two sibling `chat` spans for one operation instead of suppressing the nested call; SDK-backed subscription work likewise loses the Spring AI span as its parent. Execute the upstream source subscription in `context`, while retaining `parentContext` only for downstream application callbacks.","line":84,"path":"instrumentation/spring/spring-ai-1.0/javaagent/src/main/java/io/opentelemetry/javaagent/instrumentation/spring/ai/v1_0/SpringAiStreamTracing.java","side":"RIGHT"},{"body":"[P2] [General] Treat empty provider finish reasons as absent\n\nSpring AI 1.0.0 `OpenAiChatModel.buildGeneration` uses an empty string when a streaming chunk has no finish reason. If the consumer cancels with `take(1)`, or the stream fails after producing a partial chunk, the snapshot therefore passes this filter and records `gen_ai.response.finish_reasons = [\"\"]`; `emitResponseEvents` likewise emits `finish_reason: \"\"`. No completion reason was actually received. Ignore empty strings as well as nulls when extracting/emitting finish reasons, and do not let an empty chunk reason overwrite an already accumulated nonempty reason.","line":109,"path":"instrumentation/spring/spring-ai-1.0/javaagent/src/main/java/io/opentelemetry/javaagent/instrumentation/spring/ai/v1_0/SpringAiAttributesGetter.java","side":"RIGHT"}],"input_identity":{"pr_diff_sha256":"638e952f79603eccba0801ee4c377af712ad75ab924823ea0c88b8d792d93563"},"outcome":"comments","request_digest":"e75cd4131919c5d5e65200e87c963145dccc9d90bf88e5224de91fb95efcbe74","schema":2},"download_sha256":"c659b5818f05980ffd33d6823c2a8c4ea162a131a5335aa10a6b7a0ddae05764","frozen_sha":"76609e9354ebcbe51306d770a84555db8ef722e2","pr":19473,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"e75cd4131919c5d5e65200e87c963145dccc9d90bf88e5224de91fb95efcbe74","request_id":"c3c5d286e26f498590f7425181563bba","run_attempt":1,"run_id":38840425235,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:c659b5818f05980ffd33d6823c2a8c4ea162a131a5335aa10a6b7a0ddae05764","verification":"verified","verification_run":{"attempt":1,"id":38842755684},"workflow_revision":"1a211828aa1a2b731f5e9140623b5945a0dbdb6d"},"request":{"authorized_actor_id":218610,"base_ref":"main","base_sha":"4c07f4dfc2bda9f9ffef1f962704b7d46771a714","baseline_review_ids":[],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[],"frozen_at":1792117558,"frozen_at_iso":"2026-10-16T02:25:58Z","frozen_sha":"76609e9354ebcbe51306d770a84555db8ef722e2","head_ref":"feature/spring-ai-instrumentation","head_repo":"lrwh/opentelemetry-java-instrumentation","head_repo_id":444638416,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":38840367771},"loop_kind":"pr_review","merge_base_sha":"e7105b17886bf55f9b4954852344639862d28a6b","mode":"publish","pr":19473,"pr_author_id":17264378,"protocol":"git-candidate-v1