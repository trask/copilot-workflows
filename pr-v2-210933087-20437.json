",".github/workflows/prepare-patch-release.yml","RELEASING.md"],"commit":"f09782dda2e5086c0a332bfb6691569b5a7c70ae","commits":[{"changed_paths":[".github/scripts/changelog/fixtures/update-changelog-for-release-legacy.sh",".github/scripts/changelog/test_patch_release.py",".github/workflows/prepare-patch-release.yml","RELEASING.md"],"commit":"f09782dda2e5086c0a332bfb6691569b5a7c70ae","parent":"250c467c10caf97008c247651ab85c1409bcf3c6","patch_sha256":"1294bdc4fe832faaf18b7b5a4bf193c8c5ae118219158bc43ccfbfda92ee2a64","subject":"Restore legacy patch-release changelog preamble","tree":"b8eddac8382f9b135f67167e0be0ee1072bc6b49"}],"cumulative_patch_sha256":"1294bdc4fe832faaf18b7b5a4bf193c8c5ae118219158bc43ccfbfda92ee2a64","finding_commits":{"inline:4233516896":"f09782dda2e5086c0a332bfb6691569b5a7c70ae","review:5474123795":"f09782dda2e5086c0a332bfb6691569b5a7c70ae"},"parent":"250c467c10caf97008c247651ab85c1409bcf3c6","patch_sha256":"1294bdc4fe832faaf18b7b5a4bf193c8c5ae118219158bc43ccfbfda92ee2a64","tree":"b8eddac8382f9b135f67167e0be0ee1072bc6b49"},"dispositions":{"findings":[{"analysis":"This overview reports zero open findings and an already-resolved legacy-branch compatibility issue, rather than another actionable defect. The frozen workflow conditionally installs Towncrier and validates the legacy Unreleased heading; focused tests verify both formats and reject main. Human release end-to-end validation remains a recommendation, not a source fix or a check claimed as performed.","commit":null,"disposition":"not_warranted","key":"review:5473778857"},{"analysis":"The overview summarizes inline:4233516896. The workflow now invokes the updater from the checked-out branch instead of renaming only the heading. The historical legacy updater inserts the SDK and alpha-artifact preamble while ignoring fragments; regression coverage checks the complete preamble, preserved notes, and retained fragments.","commit":1,"disposition":"fixed","key":"review:5474123795"},{"analysis":"Confirmed that the sed-only fallback omitted the standard preamble present in the pre-adoption updater and historical patch entries. Restored branch-local updater delegation, with a pre-adoption script fixture proving the complete SDK/alpha preamble is retained, notes are unchanged, fragments remain ignored, and missing SDK metadata fails explicitly. Towncrier fragment rendering and consumption remain covered.","commit":1,"disposition":"fixed","key":"inline:4233516896"}],"input_identity":{},"outcome":"fixes","request_digest":"65a1a971edb6b8c87001a00df19a9671c1b779fa32dfb93eadee42a8c8ea0460","schema":2},"download_sha256":"55447ac4623fc941e6b04c0d70881e699e38b44385f6c1bacfc7e8e477987e48","frozen_sha":"250c467c10caf97008c247651ab85c1409bcf3c6","pr":20437,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"65a1a971edb6b8c87001a00df19a9671c1b779fa32dfb93eadee42a8c8ea0460","request_id":"f137297202874c548f44cc0525c52385","run_attempt":1,"run_id":37977378198,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:55447ac4623fc941e6b04c0d70881e699e38b44385f6c1bacfc7e8e477987e48","verification":"verified","verification_run":{"attempt":1,"id":37979128284},"workflow_revision":"9ecf52fc8587608c838ce6d40de011f37516e60b"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5448109470,5448883154,5450599717,5450770781,5450879130,5450911555,5451083471,5451343381,5451676785,5452182231,5459613552,5473720832,5473778857,5474123795],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udd35 Needs a closer look\n\nThe broad migration changes release-critical workflows and should receive final human end-to-end validation.\n\n**0 open findings**\n\n<details>\n<summary><strong>1 resolved since last review</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-light.png\" alt=\"High severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Preserve legacy release flow for pre-adoption branches](https://github.com/open-telemetry/opentelemetry-java-instrumentation/pull/20437#discussion_r4221387695)\n</details>\n\n\ud83e\udde0 **Review effort:** Balanced","comment_id":null,"key":"review:5473778857","kind":"body","line":null,"path":null,"review_id":5473778857},{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nThe legacy patch-release path omits the standard SDK and alpha-artifact preamble.\n\n<details open>\n<summary><strong>1 open finding</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Legacy releases omit the standard SDK/alpha preamble](https://github.com/open-telemetry/opentelemetry-java-instrumentation/pull/20437#discussion_r4233516896) \u00b7 New\n</details>\n\n\ud83e\udde0 **Review effort:** Balanced","comment_id":null,"key":"review:5474123795","kind":"body","line":null,"path":null,"review_id":5474123795},{"body":"[General] The legacy branch now only renames `## Unreleased`, so patch releases from pre-Towncrier branches lose the standard SDK/alpha preamble that the previous `update-changelog-for-release.sh` path inserted for every release (and that existing patch entries such as `CHANGELOG.md:390-397` contain). Because the post-release sync copies this section back to `main`, the omission becomes permanent. Keep using the legacy updater on these branches or reproduce its preamble before the notes.","comment_commit_id":"250c467c10caf97008c247651ab85c1409bcf3c6","comment_id":4233516896,"key":"inline:4233516896","kind":"inline","line":67,"original_commit_id":"250c467c10caf97008c247651ab85c1409bcf3c6","original_line":67,"path":".github/workflows/prepare-patch-release.yml","review_commit_id":"250c467c10caf97008c247651ab85c1409bcf3c6","review_id":5474123795,"review_submitted_at":"2026-10-09T18:52:18Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"194fd3bc40fde8d91486469bd0d8104d8775b0c2ff71f899ad2b09c896e5b117","id":4233516896,"parent":null,"updated_at":"2026-10-09T18:52:19Z"}],"thread_id":"PRRT_kwDODJKVX86q6G1U"}],"frozen_at":1791572385,"frozen_at_iso":"2026-10-09T18:59:45Z","frozen_sha":"250c467c10caf97008c247651ab85c1409bcf3c6","head_ref":"trask-chloggen-adoption","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":37973965598},"loop_kind":"copilot_review","mode":"publish","pr":20437,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791570745,"generation":24,"max_pipelines":5,"phase":"209892cba36a4ffea00a734ef0c2dcd7","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"f137297202874c548f44cc0525c52385","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisi