94cf0dd6acc232640b43c15d7af1a1ba56ddc5ce0ea94a2f0ab370","finding_commits":{"review:5450911555":"2e130c78ba4c34ce7716fc03fcc284caa53d0643"},"parent":"906d7644c67d54ae1aeaee1a159fb21da3f9fc20","patch_sha256":"4841cabbc73688c2f4204e106cc976cac0a87b862158886bd8702eb16f24e54a","tree":"d3ca96d74acb4c784d417fefcce28e65a7cff065"},"dispositions":{"batches":[{"analysis":"Add repo-checks steps that install Towncrier and run a non-mutating strict draft build plus the template test, so invalid fragments fail PR CI instead of release preparation.","downsides":"Adds Python setup and a few seconds to repo-checks.","findings":["review:5450911555"],"length":1348,"offset":0,"sha256":"4841cabbc73688c2f4204e106cc976cac0a87b862158886bd8702eb16f24e54a","summary":"Validate changelog fragments in PR CI","upsides":"Catches bad fragment names/types before release."}],"findings":[{"analysis":"Towncrier ran only in manual release workflows; PR CI did not validate fragments. Added draft build and template test to repo-checks.","disposition":"fixed","downsides":"Slightly longer repo-checks job.","key":"review:5450911555","upsides":"Early detection of release-blocking fragment errors."}],"outcome":"fixes","request_digest":"c2277a27ded079a0210384f158793b190bfaf9a4ae4a7175c88740e0d464fe68","schema":2},"download_sha256":"cda7494bd69ad0e362d80e53b991e92beae6c5beb3aac015f540e7e2097f2fa1","frozen_sha":"906d7644c67d54ae1aeaee1a159fb21da3f9fc20","pr":20437,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"c2277a27ded079a0210384f158793b190bfaf9a4ae4a7175c88740e0d464fe68","request_id":"724b2f76fb8540338b0c0cb813464841","run_attempt":1,"run_id":37722727821,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:cda7494bd69ad0e362d80e53b991e92beae6c5beb3aac015f540e7e2097f2fa1","verification":"verified","verification_run":{"attempt":1,"id":37723675059},"workflow_revision":"10155bc949f4a65f588b3e95e50fd182dc4528b8"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5448109470,5448883154,5450599717,5450770781,5450879130,5450911555],"budgets":{"deadline_seconds":7200,"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"deadline":1791437164,"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udd35 Needs a closer look\n\nInvalid fragments are not validated until manually triggered release preparation, allowing routine PR CI to pass with release-blocking errors.\n\n**0 open findings**\n\n<details>\n<summary><strong>1 resolved since last review</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-light.png\" alt=\"Low severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Correct inaccurate claim about preview commands in Changelog section](#discussion_r4214071969)\n</details>\n\n<details>\n<summary><strong>Previously missed (1)</strong></summary>\n\nIn code that hasn't changed since last review\n\n<details>\n<summary><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> Add PR CI check for strict Towncrier fragment validation</summary>\n\n`.github/\u200bworkflows/\u200bprepare-release-branch.yml:45`\n\n[General] Towncrier is only installed/executed by the manually triggered release workflows; the new template test renders Jinja directly and does not scan fragments. As a result, an invalid fragment name or type can pass PR CI and only fail when a release is being prepared. Add a regular PR check that installs these requirements and runs a non-mutating strict scan, such as `python -m towncrier build --draft --version 0.0.0 --date 1970-01-01`.\n</details>\n</details>\n\n\ud83e\udde0 **Review effort:** Balanced\n\n---\n\nGive feedback about Copilot approvals in [this survey](https://survey.alchemer.com/s3/9011660/CCR-Public-Preview-Autoapprove-feedback-survey) to enter a drawing for a $150 gift card.","comment_id":null,"key":"review:5450911555","kind":"body","line":null,"path":null,"review_id":5450911555}],"frozen_at":1791429964,"frozen_at_iso":"2026-10-08T03:26:04Z","frozen_sha":"906d7644c67d54ae1aeaee1a159fb21da3f9fc20","head_ref":"trask-chloggen-adoption","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"launch_run":{"actor_id":218610,"attempt":1,"id":37722681939},"loop_kind":"copilot_review","mode":"publish","pr":20437,"protocol":"reviewable-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791429966,"continuation_deadline":1791437166,"generation":4,"max_pipelines":5,"phase":"d2972d8cee3946bb8b9673c54dfaba46","profile":"reviewable-v1","required_checks":["Analyze (actions)","Analyze Java (none)","Analyze Kotlin (manual)","CodeQL","EasyCLA","build / build-servlet-images","build / common / build","build / common / check-gh-aw-lockfiles","build / common / examples","build / common / fossa-configuration-check","build / common / gradle-plugins","build / common / license-check","build / common / repo-checks","build / common / smoke-test (ubuntu-latest, jetty)","build / common / smoke-test (ubuntu-latest, liberty)","build / commo