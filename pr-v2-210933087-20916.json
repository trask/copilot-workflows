ozen_at":1793044642,"frozen_at_iso":"2026-10-26T19:57:22Z","frozen_sha":"9a5800cd124959d7563c35f596b872568a5a7978","head_ref":"copilot/task-implement-uri-template-capture","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":40391307482},"loop_kind":"pr_conflict_resolver","merge_base_sha":"35ab7b529721850466396736905973039f41bc01","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nCapture Spring WebClient URI templates so `OTEL_INSTRUMENTATION_HTTP_CLIENT_EMIT_EXPERIMENTAL_TELEMETRY=true` enables template-based client span names and `url.template`.\n\n```java\nwebClient.get().uri(\"/accounts/{id}\", \"some-account\").retrieve().bodyToMono(String.class);\n```\n\nThis produces `GET /accounts/{id}` with `url.template=/accounts/{id}`, without including the expanded account ID in either value. Applies to both Java-agent and library/starter instrumentation.\n\nWhen experimental telemetry is disabled or Spring does not preserve a template, spans retain method-only names and omit `url.template`. Spring versions before 5.0.5 remain supported but do not provide the template attribute.","title":"Capture Spring WebClient URI templates for experimental HTTP client telemetry"},"mode":"publish","pr":20916,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1793044643,"generation":1,"max_pipelines":5,"phase":"452bad25ddad4b55a64bee7186a324da","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"88ec24de1a864c6f9f52495e888d7cdd","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/872eca0e63e7e8ed0180b442ad973501f5adc20d","workflow_revision