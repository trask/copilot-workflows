d":"ci_fix","merge_base_sha":"634b8567493ec674bfe421835021b6bcab243211","mode":"publish","pr":20440,"pr_author_id":198982749,"pr_diff":{"anchors":{"docs/contributing/writing-instrumentation-module.md":[244],"instrumentation/jmx-metrics/README.md":[]},"sha256":"cb2f889d47be8b5263e4d39c1a343ca692e9c143465867223e815df243abb16a","text":"diff --git a/docs/contributing/writing-instrumentation-module.md b/docs/contributing/writing-instrumentation-module.md\nindex f1395c568505..0ee995f9ca6e 100644\n--- a/docs/contributing/writing-instrumentation-module.md\n+++ b/docs/contributing/writing-instrumentation-module.md\n@@ -241,9 +241,7 @@ Two types of instrumentation are currently supported:\n The choice between the two strategies is made by instrumentation author by using the `inline` property of the `@Advice.OnMethodEnter` and `@Advice.OnMethodExit` annotations.\n \n - if `inline` property is not set or set to `true` (default), the advice is inlined into the instrumented class files\n-- if `inline` property is explicitly set to `false`\n-  - before 3.0.0: the advice is inlined\n-  - as of 3.0.0 and later: the advice is not inlined\n+- if `inline` property is explicitly set to `false`, the advice is not inlined\n \n ## Inlined instrumentation\n \ndiff --git a/instrumentation/jmx-metrics/README.md b/instrumentation/jmx-metrics/README.md\nindex a6ea038d795a..1eed279e799f 100644\n--- a/instrumentation/jmx-metrics/README.md\n+++ b/instrumentation/jmx-metrics/README.md\n@@ -28,13 +28,6 @@ This example will enable all stable metrics except the JMX-based `jvm` definitio\n \n The deprecated `otel.jmx.target.system` setting remains a fallback when `otel.jmx.metrics.experimental.included` is empty. It collects both stable and unstable metrics for the selected targets. For example, `otel.jmx.target.system=jetty,kafka-broker` retains its existing behavior. This setting will be removed in 3.0.\n \n-To migrate, replace the target selection with metric-name patterns:\n-\n-```diff\n--otel.jmx.target.system=tomcat\n-+otel.jmx.metrics.experimental.included=tomcat.*\n-```\n-\n A nonempty experimental inclusion takes precedence over the deprecated target setting without a deprecation warning. Normal metric include/exclude filters apply in both modes.\n \n Metrics from custom YAML files do not require experimental opt-in, even if their names match unstable bundled metrics. They are controlled by the normal metric include/exclude filters.\n"},"protocol":"reviewable-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791427580,"continuation_deadline":1791434780,"generation":2,"max_pipelines":5,"phase":"af20d202a3af4a75a8ae582611fbfeee","profile":"reviewable-v1","required_checks":["Analyze (actions)","Analyze Java (none)","Analyze Kotlin (manual)","CodeQL","EasyCLA","build / build-servlet-images","build / common / build","build / common / check-gh-aw-lockfiles","build / common / examples","build / common / fossa-configuration-check","build / common / gradle-plugins","build / common / license-check","build / common / repo-checks","build / common / smoke-test (ubuntu-latest, jetty)","build / common / smoke-test (ubuntu-latest, liberty)","build / common / smoke-test (ubuntu-latest, other)","build / common / smoke-test (ubuntu-latest, payara)","build / common / smoke-test (ubuntu-latest, spring-aot)","build / common / smoke-test (ubuntu-latest, tomcat)","build / common / smoke-test (ubuntu-latest, tomee)","build / common / smoke-test (ubuntu-latest, websphere)","build / common / smoke-test (ubuntu-latest, wildfly)","build / common / spotless","build / common / test0 (11, hotspot)","build / common / test0 (17, hotspot)","build / common / test0 (21, hotspot)","build / common / test0 (25, hotspot)","build / common / test0 (25-deny-unsafe, hotspot)","build / common / test0 (27, hotspot)","build / common / test0 (8, hotspot)","build / common / test1 (11, hotspot)","build / common / test1 (17, hotspot)","build / common / test1 (