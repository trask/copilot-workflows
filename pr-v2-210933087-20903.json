ozen_at":1793018020,"frozen_at_iso":"2026-10-26T12:33:40Z","frozen_sha":"91d78691d8c95968e7b5562c7121c0d6c19eb612","head_ref":"copilot/trask-webflux-client-server-api-changes","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":40323442874},"loop_kind":"pr_conflict_resolver","merge_base_sha":"9784f7d91962b4caeea2787846de186e9d2aea66","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nReplace WebFlux client list-mutating helpers with filter factories and rename Ratpack's client instrumentation method to `wrap(...)`, matching other library APIs. These are breaking API replacements for 3.0, without deprecated aliases.\n\n```java\n// Before\nbuilder.filters(telemetry::addFilter);\nratpackTelemetry.instrument(httpClient);\n\n// After\nbuilder.filter(telemetry.createFilter());\nratpackTelemetry.wrap(httpClient);\n```\n\nFor Reactor context propagation, replace `builder.filters(telemetry::addFilterAndRegisterReactorHook)` with `builder.filter(telemetry.createFilterAndRegisterReactorHook())`.\n\nSpring Boot customizers add the filter directly; the bean postprocessor still skips clients that already have one. Server filter APIs are unchanged.","title":"Align WebFlux and Ratpack client telemetry APIs for 3.0"},"mode":"publish","pr":20903,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1793018021,"generation":1,"max_pipelines":5,"phase":"2a57582c6503449f950c0ecc4de069f7","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"85007ae803cc4779afc1c93cfd93c5a3","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/872eca0e63e7e8ed0180b