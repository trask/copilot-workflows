n_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[],"frozen_at":1793044650,"frozen_at_iso":"2026-10-26T19:57:30Z","frozen_sha":"f08f5a218d2d06d1100db960395ac42655533c7c","head_ref":"copilot/trask-webflux-client-server-api-changes","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":40391326324},"loop_kind":"pr_conflict_resolver","merge_base_sha":"3670687f578219bfaffbce542f1beea4befe92ae","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nReplace WebFlux client list-mutating helpers with filter factories and rename Ratpack's client instrumentation method to `wrap(...)`, matching other library APIs. These are breaking API replacements for 3.0, without deprecated aliases.\n\n```java\n// Before\nbuilder.filters(telemetry::addFilter);\nratpackTelemetry.instrument(httpClient);\n\n// After\nbuilder.filter(telemetry.createFilter());\nratpackTelemetry.wrap(httpClient);\n```\n\nFor Reactor context propagation, replace `builder.filters(telemetry::addFilterAndRegisterReactorHook)` with `builder.filter(telemetry.createFilterAndRegisterReactorHook())`.\n\nSpring Boot customizers add the filter directly; the bean postprocessor still skips clients that already have one. Server filter APIs are unchanged.","title":"Align WebFlux and Ratpack client telemetry APIs for 3.0"},"mode":"publish","pr":20903,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1793044651,"generation":2,"max_pipelines":5,"phase":"284844386264438d868889cc0202bfb0","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"5cfc75a140054d089bb727b5b1b7f0c4","schema":2,"s